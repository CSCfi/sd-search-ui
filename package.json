{
  "name": "sd-search-ui",
  "version": "0.1.0",
  "description": "CSC Discovery Search UI",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "prepare": "simple-git-hooks",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "lint:ci": "run-s lint:oxlint:ci lint:eslint:ci",
    "lint:oxlint:ci": "oxlint .",
    "lint:eslint:ci": "eslint .",
    "format": "prettier --write --experimental-cli src/",
    "format:ci": "prettier --check src/"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{vue,ts,scss,css,json}": "prettier --write --experimental-cli"
  },
  "dependencies": {
    "@cscfi/csc-ui": "^3.0.19",
    "@lucide/vue": "^1.52.0",
    "@tanstack/vue-query": "^5.104.1",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.20.0",
    "modern-normalize": "^3.0.1",
    "pinia": "^3.0.4",
    "vanilla-cookieconsent": "3.1.0",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@rollup/plugin-yaml": "^5.0.0",
    "@tanstack/eslint-plugin-query": "^5.104.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.19.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.60.0",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.6.0",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.60.0",
    "prettier": "3.8.3",
    "prettier-plugin-css-order": "^2.2.0",
    "sass": "^1.105.1",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.12"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "^24.18.0 || >=26.0.0"
  }
}
