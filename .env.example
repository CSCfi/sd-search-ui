# Build time environment variables set by Vite
VITE_SERVICE="bigpicture"                      # Service identity — selects router, views, config, and theme at build time
VITE_AUTH_BYPASS="false"                       # Bypass auth check for local development
VITE_REMS_URL=""                                # REMS base URL — set per environment (test/prod)

# Runtime environment variables set by Rahti deployment
BACKEND_URL="http://host.docker.internal:8000" # Backend URL for local development (used by the backend proxy) — http(s)://host[:port], no path or trailing slash
DOD_URL="" # Dataset-on-Demand service base (used by the nginx /dod proxy, container only) — no method name, no trailing slash
